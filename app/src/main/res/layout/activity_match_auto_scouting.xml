    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/leave_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/classified_ball"
        app:layout_constraintLeft_toLeftOf="@id/classified"
        android:textSize="30dp"
        android:text="Leave"
        android:layout_marginTop="30dp"
        />

    <ImageButton
        android:id="@+id/leave"
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:background="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/leave_red"

        app:layout_constraintTop_toBottomOf="@id/leave_text"
        app:layout_constraintLeft_toLeftOf="@id/leave_text"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/teleOp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TeleOp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/teamKeyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="FTC 5290"
        android:textSize="20dp"
        android:padding="20px"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

