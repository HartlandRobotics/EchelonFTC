<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".matchScouting.MatchScoutingAutoActivity">



    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/classified"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/overflow"
        android:textSize="30dp"
        android:text="Hive Tip"
        />


    <ImageButton
        android:id="@+id/classified_ball"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="fitXY"
        android:src="@drawable/hive_red"
        android:background="@null"
        app:layout_constraintTop_toBottomOf="@id/classified"
        app:layout_constraintLeft_toLeftOf="@id/classified"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/classified_ball_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/classified_ball"
        app:layout_constraintLeft_toRightOf="@+id/classified_ball"
        android:layout_marginLeft="30dp"
        android:textSize="32sp"
        tools:text="0"
        />




    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/overflow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/pattern"
        app:layout_constraintLeft_toRightOf="@id/classified"
        app:layout_constraintRight_toLeftOf="@id/missed"

        android:textSize="30dp"
        android:layout_marginTop="30dp"
        android:text="Scoring"
        />

    <ImageButton
        android:id="@+id/overflow_ball"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:scaleType="fitXY"
        android:src="@drawable/scoring_elements_red"
        android:background="@null"
        app:layout_constraintTop_toBottomOf="@id/overflow"
        app:layout_constraintLeft_toLeftOf="@id/overflow"

        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/overflow_ball_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/overflow_ball"
        app:layout_constraintLeft_toRightOf="@id/overflow_ball"
        android:layout_marginLeft="30dp"
        android:textSize="32sp"
        tools:text="0"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/park_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/leave_text"
        app:layout_constraintLeft_toLeftOf="@id/overflow"
        android:textSize="30dp"
        android:text="Park"
        />

    <ImageButton
        android:id="@+id/park"
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:background="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/park_red"
        app:layout_constraintTop_toBottomOf="@id/park_text"
        app:layout_constraintLeft_toLeftOf="@id/park_text"
        />






    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/missed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/pattern"
        app:layout_constraintLeft_toRightOf="@id/overflow"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="30dp"
        android:textSize="32sp"
        android:text="Missed"
        />

    <ImageButton
        android:id="@+id/missed_ball"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:scaleType="fitXY"
        android:src="@drawable/missing_scoring_elements_red"
        android:layout_marginLeft="15dp"
        android:background="@null"
        app:layout_constraintTop_toBottomOf="@id/missed"
        app:layout_constraintLeft_toLeftOf="@id/missed"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/missed_ball_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="32sp"
        app:layout_constraintLeft_toRightOf="@id/missed_ball"
        app:layout_constraintTop_toTopOf="@id/missed_ball"
        tools:text="0"
        android:layout_marginLeft="30dp"
        />

